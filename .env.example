# MongoDB Atlas connection string.
# Replace <user>, <password>, <cluster> with your Atlas credentials.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/adcast?retryWrites=true&w=majority"

# Session signing secret (change for production).
SESSION_SECRET="change-me-to-a-long-random-string"

# AWS Amplify Hosting: set MONGODB_URI and SESSION_SECRET as environment
# variables in the Amplify console (App settings > Environment variables).
# Do NOT commit .env — it is gitignored.
